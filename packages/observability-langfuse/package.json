{
  "name": "@anvia/langfuse",
  "version": "1.3.1",
  "description": "Langfuse tracing adapter for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/observability-langfuse"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --clean --no-fixed-extension",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^"
  }
}
