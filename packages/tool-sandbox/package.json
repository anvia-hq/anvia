{
  "name": "@anvia/sandbox",
  "version": "1.3.1",
  "description": "Sandboxed workspace tools for Anvia agents.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/tool-sandbox"
  },
  "files": [
    "dist",
    "images"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anvia-sandbox": "./dist/cli.js",
    "anvia-sandbox-daemon": "./dist/daemon-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:deps && tsup --entry.index src/index.ts --entry.cli src/cli.ts --entry.daemon-cli src/daemon-cli.ts --entry.remote src/remote/index.ts --entry.daemon src/daemon/index.ts --format esm --dts --sourcemap --clean && chmod +x dist/cli.js dist/daemon-cli.js",
    "build:deps": "test -f ../core/dist/index.d.ts || pnpm --filter @anvia/core build",
    "test": "pnpm run build:deps && vitest run",
    "typecheck": "pnpm run build:deps && tsc --noEmit",
    "bench:desktop": "tsx scripts/desktop-bench.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "@types/ws": "^8.18.2",
    "node-pty": "^1.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^",
    "node-pty": ">=1.0.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  }
}
