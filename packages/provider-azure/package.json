{
  "name": "@anvia/azure",
  "version": "0.1.0",
  "description": "Azure OpenAI provider adapter for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/provider-azure"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @anvia/openai build",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "pretypecheck": "test -f ../provider-openai/dist/index.d.ts || pnpm --filter @anvia/openai build",
    "test": "vitest run",
    "test:live": "ANVIA_AZURE_OPENAI_TESTS=1 node --env-file=../../.env ./node_modules/vitest/vitest.mjs run test/responses.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anvia/openai": "workspace:*",
    "openai": "^7.30.0"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^"
  }
}
