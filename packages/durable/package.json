{
  "name": "@anvia/durable",
  "version": "0.16.0",
  "description": "Durable agent execution with persisted model and tool checkpoints for Anvia, on SQLite, Postgres, Drizzle or Prisma.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/durable"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.16.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "import": "./dist/maintenance.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/sqlite.ts src/postgres.ts src/drizzle.ts src/prisma.ts src/drizzle-cli.ts src/prisma-cli.ts src/protocol.ts src/maintenance.ts --format esm --dts --sourcemap --clean --no-fixed-extension",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@anvia/memory-sqlite": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:>=1.19.1 <2.0.0",
    "zod": "^4.6.7",
    "pg": "^8.23.1",
    "drizzle-orm": ">=0.45.3 <1.0.0",
    "@prisma/client": ">=7.10.0 <8.0.0"
  },
  "bin": {
    "anvia-durable-drizzle": "./dist/drizzle-cli.js",
    "anvia-durable-prisma": "./dist/prisma-cli.js"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  }
}
