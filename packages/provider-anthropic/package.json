{
  "name": "@anvia/anthropic",
  "version": "1.2.1",
  "description": "Anthropic provider adapter for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/provider-anthropic"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "test -f ../core/dist/index.d.ts || pnpm --filter @anvia/core build",
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --clean --no-fixed-extension",
    "test": "vitest run",
    "pretypecheck": "test -f ../core/dist/index.d.ts || pnpm --filter @anvia/core build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@anthropic-ai/vertex-sdk": "^1.1.2"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^"
  }
}
