{
  "name": "@anvia/milvus",
  "version": "1.2.0",
  "description": "Milvus vector store adapter for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/vector-milvus"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --clean --no-fixed-extension",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilliz/milvus2-sdk-node": "^3.0.6"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^"
  }
}
