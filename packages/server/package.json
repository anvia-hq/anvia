{
  "name": "@anvia/server",
  "version": "1.4.0",
  "description": "Server-side client protocol and generic event stream responses for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/durable.ts --format esm --dts --sourcemap --clean --no-fixed-extension",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anvia/client": "workspace:*",
    "@anvia/durable": "workspace:*",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@anvia/client": "workspace:^",
    "@anvia/durable": "workspace:>=0.8.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@anvia/durable": {
      "optional": true
    }
  }
}
