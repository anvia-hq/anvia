{
  "name": "@anvia/extensions",
  "version": "0.1.0",
  "description": "Standard toolkits, guardrails, middlewares, and lifecycle hooks for Anvia agents.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/extensions"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./tools/web-search": {
      "types": "./dist/tools/web-search/index.d.ts",
      "import": "./dist/tools/web-search/index.js"
    },
    "./tools/web-fetch": {
      "types": "./dist/tools/web-fetch/index.d.ts",
      "import": "./dist/tools/web-fetch/index.js"
    },
    "./tools/fs": {
      "types": "./dist/tools/fs/index.d.ts",
      "import": "./dist/tools/fs/index.js"
    },
    "./tools/http": {
      "types": "./dist/tools/http/index.d.ts",
      "import": "./dist/tools/http/index.js"
    },
    "./tools/todo": {
      "types": "./dist/tools/todo/index.d.ts",
      "import": "./dist/tools/todo/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js"
    },
    "./middlewares": {
      "types": "./dist/middlewares/index.d.ts",
      "import": "./dist/middlewares/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@types/node": "^24.9.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  }
}
