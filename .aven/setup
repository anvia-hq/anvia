#!/usr/bin/env bash
# Anvia thread setup: check the machine, then install what the project needs.
#
# Versions, and where the repository names them (CI wins over the docs):
# - Node.js 24      .github/workflows/ci.yml, actions/setup-node node-version 24.
#                   (DEVELOPMENT.md still says "20 or newer"; CI is the newer statement.)
# - pnpm 11.0.4     package.json "packageManager", ci.yml pnpm/action-setup 11.0.4.
# - make, g++, python3
#                   node-pty compiles from source on Linux (no prebuild in the
#                   package), packages/tool-sandbox depends on it, and
#                   pnpm-workspace.yaml lists it under allowBuilds.
#
# Toolchain: mise installs Node into the home folder, so nothing here needs root.
# The machine had no Node, npm or pnpm when this script was written.
#
# No service is started and none is needed: unit tests mock the provider SDKs,
# and every live integration (Postgres, Prisma, ChromaDB, Qdrant, Memgraph,
# Langfuse, Docker sandbox) is gated behind an opt-in variable and skips.
# Docker is only for cookbook retrieval examples and sandbox tests.
# No secret is read or written here; keys come from the project's variables.
set -euo pipefail
cd "$(dirname "$0")/.."

# A command gets a bare shell with the runner service's PATH, so put the usual
# per-user install locations on it ourselves.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

missing=0
fail() {
  echo "missing  $1"
  echo "         $2"
  missing=1
}

echo "step     checking the machine"
if command -v git >/dev/null 2>&1; then
  echo "ok       git $(git --version | cut -d' ' -f3)"
else
  fail git "install git: sudo apt-get install -y git"
fi

if command -v mise >/dev/null 2>&1; then
  echo "ok       mise $(mise --version)"
else
  fail mise "run: curl https://mise.run | sh   (installs into your home folder, no root, no sudo)"
fi

for tool in python3 make g++; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "ok       $tool"
  else
    fail "$tool" "run: sudo apt-get install -y build-essential python3   (node-pty compiles at install)"
  fi
done

if command -v docker >/dev/null 2>&1; then
  echo "ok       docker $(docker --version | cut -d' ' -f3 | tr -d ',') (optional: cookbook retrieval and sandbox tests)"
else
  echo "note     docker not found (optional, only for cookbook retrieval examples and ANVIA_SANDBOX_DOCKER_TESTS)"
fi

if [ "$missing" -ne 0 ]; then
  echo "fail     install what is missing above, then run this again"
  exit 1
fi

echo "step     node 24 via mise"
mise use -g node@24 >/dev/null
mise reshim >/dev/null 2>&1 || true
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$node_major" != "24" ]; then
  echo "fail     mise gave node $node_major, expected 24 (the version CI uses)"
  exit 1
fi
echo "         node $(node -v)"

echo "step     pnpm 11.0.4"
if ! command -v pnpm >/dev/null 2>&1 || [ "$(pnpm --version)" != "11.0.4" ]; then
  npm install -g pnpm@11.0.4 --no-audit --no-fund --silent
  mise reshim >/dev/null 2>&1 || true
fi
if [ "$(pnpm --version)" != "11.0.4" ]; then
  echo "fail     pnpm $(pnpm --version), expected 11.0.4 (package.json packageManager)"
  exit 1
fi
echo "         pnpm $(pnpm --version)"

echo "step     dependencies from the lockfile"
pnpm install --frozen-lockfile --silent

if [ -f .env.example ] && [ ! -f .env ]; then
  cp .env.example .env
  echo "step     .env made from .env.example (empty values, not secrets)"
fi

# Dependent packages resolve @anvia/core through dist in typecheck/build, while
# vitest maps it to src. Building core here makes package-scoped typecheck work
# right after setup, the same order CI uses.
echo "step     build @anvia/core"
pnpm --filter @anvia/core build >/dev/null

echo "done     ready. pnpm check | typecheck | test | build"
echo "note     live provider examples need keys as project variables (Settings > Variables):"
echo "         OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, XAI_API_KEY,"
echo "         OPENROUTER_API_KEY, AZURE_OPENAI_API_KEY. Nothing above needs them."