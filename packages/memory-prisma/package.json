{
  "name": "@anvia/memory-prisma",
  "version": "1.1.3",
  "description": "Prisma-backed durable session memory store for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/memory-prisma"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anvia-memory-prisma": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v8": {
      "types": "./dist/v8.d.ts",
      "import": "./dist/v8.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/v8.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anvia/core": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "@anvia/core": "workspace:^",
    "@prisma/client": ">=7.10.0 <8.0.0",
    "@prisma/orm-postgres": "8.0.0-rc.11"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@prisma/orm-postgres": {
      "optional": true
    }
  }
}
